<view class="container">
  <view class="header">
    <text>口腔健康科普</text>
  </view>
  <view class="dots-container">
    <view class="dot" wx:for="{{imageList}}" wx:key="id">
      <image src="{{item[0]}}" mode="aspectFill"></image>
    </view>
  </view>
  <view class="content">
    <view class="article" wx:for="{{articles}}" wx:key="id" bindtap="navigateToDetail" data-id="{{index}}">
      <view class="article-header">
        <text class="article-title">{{item.title}}</text>
        <text class="article-type-tag {{item.type === 'video' ? 'tag-video' : 'tag-article'}}">{{item.type === 'video' ? '视频' : '文章'}}</text>
      </view>
    </view>
  </view>
</view>