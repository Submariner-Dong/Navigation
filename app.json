{
  "pages": [
    "pages/index/index"
  ],

  "subPackages": [
    {
      "root": "pkg-navigation", 
      "pages": [
        "navigation/navigation", 
        "navigation/department/department", 
        "map/map"
      ]
    }, 
    {
      "root": "pkg-science", 
      "pages": [
        "science/science", 
        "science/detail/detail"
      ]
    }, 
    {
      "root": "pkg-profile", 
      "pages": [
        "profile/profile", 
        "profile/medical-record-detail/medical-record-detail", 
        "profile/medical-record/medical-record"
      ]
    }, 
    {
      "root": "pkg-auth", 
      "pages": [
        "auth/auth"
      ]
    }, 
    {
      "root": "pkg-ai",
      "pages": [
        "ai-diagnosis/ai-diagnosis"
      ]
    }
  ],

  "preloadRule": {
    "pages/index/index":{
      "network": "all", 
      "packages": ["pkg-navigation", "pkg-science"]
    }
  },

  "window": {
    "navigationBarTitleText": "青芽智医",
    "navigationBarBackgroundColor": "#ffffff",
    "navigationBarTextStyle": "black"
  },
  "permission": {
    "scope.userLocation": {
      "desc": "你的位置信息将用于小程序定位功能"
    }
  },
  "requiredPrivateInfos": ["getLocation", "onLocationChange", "startLocationUpdate"],
  "networkTimeout": {
    "request": 10000
  },
  "style": "v2",
  "sitemapLocation": "sitemap.json",
  "lazyCodeLoading": "requiredComponents"
}