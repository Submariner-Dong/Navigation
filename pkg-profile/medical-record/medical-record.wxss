.container {
  min-height: 100vh;
  background-color: #f5f5f5;
  padding: 20rpx;
  padding-bottom: 160rpx;
}

.form-section {
  margin-bottom: 24rpx;
}

.field-label {
  font-size: 28rpx;
  color: #333;
  font-weight: 500;
}

.field-input {
  font-size: 26rpx;
  color: #666;
  text-align: right;
  min-width: 300rpx;
}

.field-textarea {
  font-size: 26rpx;
  color: #666;
  text-align: left;
  width: 100%;
  min-height: 80rpx;
  padding: 10rpx 0;
}

.picker-value {
  font-size: 26rpx;
  color: #666;
  text-align: right;
}

.picker-value.placeholder {
  color: #ccc;
}

/* 底部操作按钮 */
.action-buttons {
  display: flex;
  gap: 24rpx;
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  padding: 20rpx 30rpx;
  background-color: #fff;
  box-shadow: 0 -4rpx 16rpx rgba(0, 0, 0, 0.08);
}

.action-btn {
  flex: 1;
  height: 88rpx;
  font-size: 30rpx;
  font-weight: 600;
  border-radius: 12rpx;
}
