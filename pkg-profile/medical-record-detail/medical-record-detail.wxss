.container {
  min-height: 100vh;
  background-color: #f5f5f5;
  padding: 20rpx;
}

/* 头部信息卡片 */
.header-card {
  background: linear-gradient(135deg, #1677ff 0%, #4096ff 100%);
  border-radius: 16rpx;
  padding: 40rpx 32rpx;
  margin-bottom: 24rpx;
  color: white;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.1);
}

.department-info {
  display: flex;
  align-items: center;
  margin-bottom: 24rpx;
}

.department-tag {
  margin-right: 20rpx;
}

.doctor-info {
  display: flex;
  flex-direction: column;
}

.doctor-name {
  font-size: 32rpx;
  font-weight: 600;
  margin-bottom: 8rpx;
}

.doctor-title {
  font-size: 24rpx;
  opacity: 0.9;
}

.diagnosis-info {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.diagnosis-text {
  font-size: 28rpx;
  font-weight: 500;
}

.visit-time {
  font-size: 24rpx;
  opacity: 0.9;
}

/* 内容区域 */
.content-section {
  background: white;
  border-radius: 16rpx;
  margin-bottom: 24rpx;
  overflow: hidden;
}

.info-label {
  font-size: 28rpx;
  color: #333;
  font-weight: 500;
}

.info-value {
  font-size: 26rpx;
  color: #666;
  line-height: 1.6;
  text-align: right;
}

/* 底部操作按钮 */
.action-buttons {
  display: flex;
  gap: 30rpx;
  margin-top: 60rpx;
  padding: 0 20rpx;
}

.action-btn {
  flex: 1;
  height: 88rpx;
  font-size: 32rpx;
  font-weight: 600;
  border-radius: 12rpx;
  box-shadow: 0 8rpx 20rpx rgba(0, 0, 0, 0.15);
  transition: all 0.3s ease;
  min-width: 0 !important;
  max-width: none !important;
  width: auto !important;
  display: flex;
  align-items: center;
  justify-content: center;
  text-align: center;
}

.action-btn:active {
  transform: translateY(4rpx);
  box-shadow: 0 4rpx 10rpx rgba(0, 0, 0, 0.2);
}

/* 复制按钮样式 */
.copy-btn {
  background: linear-gradient(135deg, #f0f0f0 0%, #d9d9d9 100%);
  border: 2rpx solid #d9d9d9;
  color: #333;
  padding: 0;
  margin: 0;
  line-height: 88rpx;
  border-radius: 12rpx;
}

.copy-btn::after {
  border: none;
}

.copy-btn:active {
  background: linear-gradient(135deg, #e0e0e0 0%, #c9c9c9 100%);
}

/* 分享按钮样式 */
.share-btn {
  background: linear-gradient(135deg, #1677ff 0%, #4096ff 100%);
  border: 2rpx solid #1677ff;
  color: white;
  padding: 0;
  margin: 0;
  line-height: 88rpx;
  border-radius: 12rpx;
}

.share-btn::after {
  border: none;
}

.share-btn:active {
  background: linear-gradient(135deg, #0d63e6 0%, #2d85e6 100%);
}

/* ========== 修改按钮 ========== */
.edit-section {
  padding: 20rpx 30rpx;
  border-top: 1rpx solid #f0f0f0;
}

.edit-btn {
  width: 100%;
  border-radius: 12rpx;
}

/* 无数据状态 */
.no-data {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  height: 60vh;
  text-align: center;
}

.back-btn {
  margin-top: 40rpx;
  width: 200rpx;
}

/* 响应式调整 */
@media (max-width: 375px) {
  .container {
    padding: 16rpx;
  }
  
  .header-card {
    padding: 32rpx 24rpx;
  }
  
  .doctor-name {
    font-size: 28rpx;
  }
  
  .diagnosis-text {
    font-size: 26rpx;
  }
}

/* 深色模式适配 */
@media (prefers-color-scheme: dark) {
  .container {
    background-color: #1a1a1a;
  }
  
  .content-section {
    background: #2a2a2a;
  }
  
  .info-label {
    color: #e0e0e0;
  }
  
  .info-value {
    color: #b0b0b0;
  }
}