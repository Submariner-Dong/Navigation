/* ========== AI智能问诊页面样式 - 对话式布局 ========== */

/* 主容器 - 对应ai-diagnosis.wxml中的<view class="container"> */
.container {
  display: flex;
  flex-direction: column;
  height: 100vh;
  background-color: #f8f9fa;
}

/* 聊天容器 - 对应<scroll-view class="chat-container">，支持滚动 */
.chat-container {
  flex: 1;
  min-height: 0;           /* 关键：防止 flex 子元素溢出 */
  padding: 0 0 10px 0;     /* 默认底部留出输入区空间 */
  background-color: #f8f9fa;
}

/* 消息容器 - 对应<view class="message-container {{item.type}}"> */
.message-container {
  padding: 0 16px;
  margin-bottom: 16px;
}

/* 消息项 - 对应<view class="message-item ai">和<view class="message-item user"> */
.message-item {
  display: flex;
  align-items: flex-start;
}

.message-item.ai {
  justify-content: flex-start;
}

.message-item.user {
  justify-content: flex-end;
}

/* 头像样式 - 对应<image class="avatar"> */
.avatar {
  width: 36px;
  height: 36px;
  border-radius: 50%;
  background-color: #e0e0e0;
}

.message-item.ai .avatar {
  margin-right: 8px;
}

.message-item.user .avatar {
  margin-left: 8px;
}

/* 消息气泡 - 对应<view class="message-bubble ai">和<view class="message-bubble user"> */
.message-bubble {
  max-width: 70%;
  padding: 12px 16px;
  border-radius: 18px;
  word-wrap: break-word;
  position: relative;
}

.message-bubble.ai {
  background-color: #ffffff;
  border: 1px solid #e0e0e0;
  border-bottom-left-radius: 4px;
}

.message-bubble.user {
  background-color: #07c160;
  color: white;
  border-bottom-right-radius: 4px;
}

/* 消息内容 - 对应<text class="message-content"> */
.message-content {
  font-size: 14px;
  line-height: 1.4;
  white-space: pre-wrap;
}

/* 输入容器 - 固定在底部，随键盘上浮 */
.input-container {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  display: flex;
  padding: 12px 16px;
  background-color: white;
  border-top: 1px solid #e0e0e0;
  align-items: center;
  z-index: 100;
}

/* 输入框样式 - 对应<input class="input-box"> */
.input-box {
  flex: 1;
  padding: 10px 12px;
  border: 1px solid #e0e0e0;
  border-radius: 20px;
  font-size: 14px;
  background-color: #f8f9fa;
}

/* 发送按钮样式 - 对应<button class="send-btn"> */
.send-btn {
  margin-left: 8px;
  padding: 10px 20px;
  background-color: #07c160;
  color: white;
  border: none;
  border-radius: 20px;
  font-size: 14px;
  min-width: 60px;
}

.send-btn:active {
  background-color: #009146;
}

/* 推荐区域 - 对应<view class="recommendation" wx:if="{{recommendedDepartment}}"> */
.recommendation {
  padding: 16px;
  background-color: #fff3e0;
  border-top: 1px solid #ddd;
  margin-bottom: 60px;     /* 为固定定位的输入区域留出空间 */
}

/* 推荐标题样式 - 对应<text class="title">推荐科室：{{recommendedDepartment}}</text> */
.title {
  font-weight: bold;
  font-size: 16px;
  color: #333;
}

/* 导航按钮样式 - 对应<button class="nav-btn" bindtap="navigateToDepartment">前往导航</button> */
.nav-btn {
  background-color: #ff9800;
  color: white;
  padding: 10px 20px;
  border-radius: 20px;
  border: none;
  margin-top: 10px;
  font-size: 14px;
}

.nav-btn:active {
  background-color: #e68900;
}

/* ========== 专家数字分身模式样式 ========== */

/* 模式切换栏 */
.mode-bar {
  padding: 8px 16px;
  background-color: white;
  border-bottom: 1px solid #eee;
}

.mode-tabs {
  display: flex;
  flex-direction: row;
}

.mode-tab {
  flex: 1;
  text-align: center;
  padding: 10px 0;
  font-size: 14px;
  color: #666;
  position: relative;
  transition: all 0.2s ease;
}

.mode-tab.active {
  color: #1976d2;
  font-weight: bold;
  font-size: 15px;
}

.mode-tab.active::after {
  content: '';
  position: absolute;
  bottom: 0;
  left: 50%;
  transform: translateX(-50%);
  width: 40px;
  height: 3px;
  background-color: #1976d2;
  border-radius: 2px;
}

/* 当前选中专家信息条 */
.doctor-info-bar {
  margin-top: 6px;
  padding: 6px 12px;
  background-color: #e3f2fd;
  border-radius: 12px;
}

.doctor-info-text {
  font-size: 12px;
  color: #1565c0;
  display: block;
}

/* 医生选择面板遮罩 */
.doctor-list-overlay {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background-color: rgba(0, 0, 0, 0.5);
  z-index: 9999;
  display: flex;
  align-items: center;
  justify-content: center;
}

/* 医生选择面板 */
.doctor-list-panel {
  width: 80%;
  max-width: 380px;
  background-color: white;
  border-radius: 16px;
  overflow: hidden;
  z-index: 10000;
}

.doctor-list-header {
  padding: 20px 20px 10px;
  text-align: center;
}

.doctor-list-title {
  font-size: 18px;
  font-weight: bold;
  color: #333;
}

/* 医生卡片 */
.doctor-card {
  margin: 10px 16px;
  padding: 16px;
  background-color: #f8f9fa;
  border-radius: 12px;
  border: 2px solid transparent;
  transition: all 0.2s ease;
}

.doctor-card:active {
  background-color: #e3f2fd;
  border-color: #1976d2;
}

.doctor-card-main {
  display: flex;
  align-items: center;
  margin-bottom: 8px;
}

.doctor-name {
  font-size: 17px;
  font-weight: bold;
  color: #333;
  margin-right: 8px;
}

.doctor-title {
  font-size: 13px;
  color: #666;
  margin-right: 8px;
  background-color: #e8e8e8;
  padding: 2px 8px;
  border-radius: 4px;
}

.doctor-dept {
  font-size: 13px;
  color: #1976d2;
  font-weight: 500;
}

.doctor-desc {
  font-size: 13px;
  color: #888;
  line-height: 1.5;
  display: block;
}

/* 关闭按钮 */
.doctor-list-close {
  padding: 16px;
  text-align: center;
  border-top: 1px solid #eee;
}

.doctor-list-close text {
  color: #999;
  font-size: 15px;
}

.doctor-list-close:active {
  background-color: #f5f5f5;
}

/* 专家模式下的聊天区域 */
.chat-container.expert-mode {
  /* 可根据需要调整专家模式下的背景色 */
  background-color: #fafafa;
}

/* 专家模式发送按钮 */
.send-expert {
  background-color: #1976d2 !important;
}

.send-expert:active {
  background-color: #1565c0 !important;
}