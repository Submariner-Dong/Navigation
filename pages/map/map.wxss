/* 页面容器 */
.container {
  height: 100vh;
  display: flex;
  flex-direction: column;
}

/* 地图区域 */
.map-section {
  height: 300rpx;
  background: #f0f0f0;
  transition: height 0.3s ease;
}

.map-section.navigating {
  height: 60vh;
}

.map {
  width: 100%;
  height: 100%;
}

/* 导航信息 */
.navigation-info {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  background: white;
  padding: 30rpx;
  border-radius: 20rpx 20rpx 0 0;
  box-shadow: 0 -2rpx 10rpx rgba(0, 0, 0, 0.1);
  transform: translateY(100%);
  transition: all 0.3s ease;
  z-index: 1000;
}

.navigation-info.show {
  transform: translateY(0);
}

.nav-progress {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 30rpx;
}

.current-step {
  font-size: 28rpx;
  font-weight: bold;
  color: #333;
  flex: 1;
}

.step-count {
  font-size: 24rpx;
  color: #666;
  background: #f0f0f0;
  padding: 8rpx 16rpx;
  border-radius: 20rpx;
}

.nav-controls {
  display: flex;
  gap: 20rpx;
}

.control-btn {
  flex: 1;
  background: #1976d2;
  color: white;
  text-align: center;
  padding: 20rpx;
  border-radius: 10rpx;
  font-size: 28rpx;
  font-weight: bold;
}

.control-btn:active {
  background: #1565c0;
}

/* 导航信息区域 */
.nav-section {
  flex: 1;
  background: #fff;
  padding: 30rpx;
  overflow-y: auto;
}

/* 医院信息 */
.hospital-info {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 40rpx;
  padding-bottom: 20rpx;
  border-bottom: 1rpx solid #eee;
}

.hospital-name {
  font-size: 32rpx;
  font-weight: bold;
  color: #333;
}

.distance-info {
  display: flex;
  flex-direction: column;
  align-items: flex-end;
}

.distance {
  font-size: 28rpx;
  color: #666;
  margin-bottom: 8rpx;
}

.time {
  font-size: 24rpx;
  color: #999;
}

/* 导航方式选择 */
.nav-methods {
  margin-bottom: 40rpx;
}

.nav-title {
  font-size: 28rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 20rpx;
}

.nav-method {
  display: flex;
  align-items: center;
  padding: 20rpx;
  margin-bottom: 15rpx;
  border: 2rpx solid #eee;
  border-radius: 12rpx;
  transition: all 0.3s ease;
}

.nav-method.active {
  border-color: #1976d2;
  background-color: #f0f8ff;
}

.method-icon {
  font-size: 36rpx;
  margin-right: 20rpx;
  width: 60rpx;
  text-align: center;
}

.method-info {
  flex: 1;
}

.method-name {
  font-size: 28rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 8rpx;
}

.method-detail {
  font-size: 24rpx;
  color: #666;
}

/* 导航详情 */
.nav-details {
  margin-bottom: 40rpx;
}

.details-title {
  font-size: 28rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 20rpx;
}

.route-list {
  max-height: 300rpx;
  border: 1rpx solid #eee;
  border-radius: 12rpx;
  padding: 0 20rpx;
}

.route-step {
  display: flex;
  align-items: center;
  padding: 20rpx 0;
  border-bottom: 1rpx solid #f0f0f0;
}

.route-step:last-child {
  border-bottom: none;
}

.step-icon {
  font-size: 28rpx;
  margin-right: 20rpx;
  width: 40rpx;
  text-align: center;
}

.step-info {
  flex: 1;
}

.step-instruction {
  font-size: 26rpx;
  color: #333;
  margin-bottom: 8rpx;
}

.step-distance {
  font-size: 22rpx;
  color: #666;
}

/* 开始导航按钮 */
.start-nav-btn {
  background: linear-gradient(135deg, #1976d2, #1565c0);
  color: white;
  text-align: center;
  padding: 25rpx;
  border-radius: 12rpx;
  font-size: 32rpx;
  font-weight: bold;
  box-shadow: 0 4rpx 12rpx rgba(25, 118, 210, 0.3);
}

.btn-text {
  color: white;
}

/* 响应式设计 */
@media (max-width: 375rpx) {
  .nav-section {
    padding: 20rpx;
  }
  
  .hospital-name {
    font-size: 28rpx;
  }
  
  .nav-method {
    padding: 15rpx;
  }
}

/* 交互效果 */
.nav-method:active {
  transform: scale(0.98);
}

.start-nav-btn:active {
  transform: translateY(2rpx);
  box-shadow: 0 2rpx 6rpx rgba(25, 118, 210, 0.3);
}