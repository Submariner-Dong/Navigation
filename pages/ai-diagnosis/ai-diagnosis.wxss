/* ========== AI智能问诊页面样式 - 对话式布局 ========== */

/* 主容器 - 对应ai-diagnosis.wxml中的<view class="container"> */
.container {
  display: flex;
  flex-direction: column;
  height: 100vh;
  background-color: #f8f9fa;
}

/* 聊天容器 - 对应<scroll-view class="chat-container">，支持滚动 */
.chat-container {
  flex: 1;
  padding: 0;
  background-color: #f8f9fa;
}

/* 消息容器 - 对应<view class="message-container {{item.type}}"> */
.message-container {
  padding: 0 16px;
  margin-bottom: 16px;
}

/* 消息项 - 对应<view class="message-item ai">和<view class="message-item user"> */
.message-item {
  display: flex;
  align-items: flex-start;
}

.message-item.ai {
  justify-content: flex-start;
}

.message-item.user {
  justify-content: flex-end;
}

/* 头像样式 - 对应<image class="avatar"> */
.avatar {
  width: 36px;
  height: 36px;
  border-radius: 50%;
  background-color: #e0e0e0;
}

.message-item.ai .avatar {
  margin-right: 8px;
}

.message-item.user .avatar {
  margin-left: 8px;
}

/* 消息气泡 - 对应<view class="message-bubble ai">和<view class="message-bubble user"> */
.message-bubble {
  max-width: 70%;
  padding: 12px 16px;
  border-radius: 18px;
  word-wrap: break-word;
  position: relative;
}

.message-bubble.ai {
  background-color: #ffffff;
  border: 1px solid #e0e0e0;
  border-bottom-left-radius: 4px;
}

.message-bubble.user {
  background-color: #07c160;
  color: white;
  border-bottom-right-radius: 4px;
}

/* 消息内容 - 对应<text class="message-content"> */
.message-content {
  font-size: 14px;
  line-height: 1.4;
  white-space: pre-wrap;
}

/* 输入容器 - 对应<view class="input-container"> */
.input-container {
  display: flex;
  padding: 12px 16px;
  background-color: white;
  border-top: 1px solid #e0e0e0;
  align-items: center;
}

/* 输入框样式 - 对应<input class="input-box"> */
.input-box {
  flex: 1;
  padding: 10px 12px;
  border: 1px solid #e0e0e0;
  border-radius: 20px;
  font-size: 14px;
  background-color: #f8f9fa;
}

/* 发送按钮样式 - 对应<button class="send-btn"> */
.send-btn {
  margin-left: 8px;
  padding: 10px 20px;
  background-color: #07c160;
  color: white;
  border: none;
  border-radius: 20px;
  font-size: 14px;
  min-width: 60px;
}

.send-btn:active {
  background-color: #009146;
}

/* 推荐区域 - 对应<view class="recommendation" wx:if="{{recommendedDepartment}}"> */
.recommendation {
  padding: 16px;
  background-color: #fff3e0;
  border-top: 1px solid #ddd;
}

/* 推荐标题样式 - 对应<text class="title">推荐科室：{{recommendedDepartment}}</text> */
.title {
  font-weight: bold;
  font-size: 16px;
  color: #333;
}

/* 导航按钮样式 - 对应<button class="nav-btn" bindtap="navigateToDepartment">前往导航</button> */
.nav-btn {
  background-color: #ff9800;
  color: white;
  padding: 10px 20px;
  border-radius: 20px;
  border: none;
  margin-top: 10px;
  font-size: 14px;
}

.nav-btn:active {
  background-color: #e68900;
}