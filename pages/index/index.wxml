<view class="container">
  <!-- 顶部轮播图区域 -->
  <view class="carousel-section">
    <swiper class="carousel" indicator-dots="true" autoplay="true" interval="3000" duration="500">
      <swiper-item>
        <image src="{{images.CAROUSEL_1}}" mode="aspectFill" class="carousel-image"></image>
      </swiper-item>
      <swiper-item>
        <image src="{{images.CAROUSEL_2}}" mode="aspectFill" class="carousel-image"></image>
      </swiper-item>
      <swiper-item>
        <image src="{{images.CAROUSEL_3}}" mode="aspectFill" class="carousel-image"></image>
      </swiper-item>
    </swiper>
  </view>

  <!-- 原有内容区域，向下移动 -->
  <view class="content">
    <view class="button-grid">
      <!-- 第一行：科普知识和院内导航 -->
      <view class="grid-row">
        <view class="grid-item">
          <navigator url="/pages/science/science" class="btn">
            <image src="{{images.INDEX_BUTTON_1}}" mode="aspectFit" class="button-image"></image>
          </navigator>
        </view>
        <view class="grid-item">
          <navigator url="/pages/navigation/navigation" class="btn">
            <image src="{{images.INDEX_BUTTON_2}}" mode="aspectFit" class="button-image"></image>
          </navigator>
        </view>
      </view>
      
      <!-- 第二行：AI智能问诊和个人中心 -->
      <view class="grid-row">
        <view class="grid-item">
          <navigator url="/pages/ai-diagnosis/ai-diagnosis" class="btn">
            <image src="{{images.INDEX_BUTTON_3}}" mode="aspectFit" class="button-image"></image>
          </navigator>
        </view>
        <view class="grid-item">
          <navigator url="/pages/profile/profile" class="btn">
            <image src="{{images.INDEX_BUTTON_4}}" mode="aspectFit" class="button-image"></image>
          </navigator>
        </view>
      </view>
    </view>
  </view>

  <!-- 底部导航栏 -->
  <view class="bottom-nav">
    <view class="nav-item {{currentPage === 'index' ? 'active' : ''}}" bindtap="switchToIndex">
      <image src="{{images.HOME_ICON}}" mode="aspectFit" class="nav-icon"></image>
      <text class="nav-text">首页</text>
    </view>
    <view class="nav-item {{currentPage === 'profile' ? 'active' : ''}}" bindtap="switchToProfile">
      <image src="{{images.PROFILE_ICON}}" mode="aspectFit" class="nav-icon"></image>
      <text class="nav-text">我的</text>
    </view>
  </view>
</view>