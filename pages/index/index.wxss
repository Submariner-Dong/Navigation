/* ========== 首页样式 - index.wxml对应 ========== */

/* 主容器 - 对应index.wxml中的<view class="container"> */
.container {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 0;
  background-size: cover;
  background-position: center;
  background-repeat: no-repeat;
  min-height: 100vh;
}

/* 轮播图区域 - 占屏幕顶部三分之一 */
.carousel-section {
  width: 100%;
  height: 33vh;
  margin-bottom: 20px;
}

.carousel {
  width: 100%;
  height: 100%;
}

.carousel-image {
  width: 100%;
  height: 100%;
}

/* 内容区域 - 对应<view class="content">，包含所有功能入口 */
.content {
  display: flex;
  flex-direction: column;
  gap: 15px;
  align-items: center;
  padding: 0 20px;
  flex: 1;
}

/* 按钮网格容器 - 对应<view class="button-grid">，实现2x2布局 */
.button-grid {
  display: flex;
  flex-direction: column;
  gap: 40px;
  width: 100%;
  max-width: 600px;
}

/* 网格行 - 对应<view class="grid-row">，每行包含2个按钮 */
.grid-row {
  display: flex;
  justify-content: space-between;
  gap: 0px;
}

/* 网格项 - 对应<view class="grid-item">，每个按钮容器 */
.grid-item {
  flex: 1;
  display: flex;
  justify-content: center;
}

/* 按钮样式 - 对应<navigator class="btn">，用于功能入口导航 */
.btn {
  padding: 10px 20px;
  background-color: #11ffee00; /* 透明背景色 */
  color: black;
  text-align: center;
  border-radius: 5px;
  display: flex;
  justify-content: center;
  align-items: center;
}

/* 按钮图片样式 - 对应<image class="button-image"> */
.button-image {
  width: 150px;
  height: 150px;
}

/* 底部导航栏 */
.bottom-nav {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  display: flex;
  background-color: #fff;
  border-top: 1px solid #eee;
  height: 60px;
  z-index: 1000;
}

.nav-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 8px 0;
}

.nav-item.active {
  background-color: #f0f8ff;
}

.nav-icon {
  width: 24px;
  height: 24px;
  margin-bottom: 4px;
}

.nav-text {
  font-size: 12px;
  color: #000000;
}

.nav-item.active .nav-text {
  color: #1aad19;
}

/* 备用按钮图片样式（当前未使用） */
.button-image1 {
  width: 80px;
  height: 80px;
}
.button-image2 {
  width: 80px;
  height: 80px;
}
