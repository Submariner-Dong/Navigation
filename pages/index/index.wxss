/* ========== 首页样式 - index.wxml对应 ========== */

/* 主容器 - 对应index.wxml中的<view class="container"> */
.container {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 0;
  background-size: cover;
  background-position: center;
  background-repeat: no-repeat;
  min-height: 100vh;
}

/* ========== 模式切换开关栏 ========== */
.mode-switch-bar {
  width: 100%;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 10rpx 30rpx;
  background-color: #f8f9fa;
  border-bottom: 1px solid #eee;
  gap: 16rpx;
}

.mode-switch-label {
  font-size: 26rpx;
  color: #666;
}

.elderly-switch {
  background-color: #fff8e1;
  border-bottom: 2px solid #ffc107;
  padding: 12rpx 30rpx;
}

.elderly-text {
  font-size: 32rpx !important;
  color: #e65100 !important;
  font-weight: bold;
}

/* ========== 老年版 UI 样式 ========== */
.elderly-container {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 40rpx 30rpx;
  flex: 1;
  width: 100%;
  box-sizing: border-box;
}

.elderly-header {
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-bottom: 60rpx;
  margin-top: 20rpx;
}

.elderly-title {
  font-size: 64rpx;
  font-weight: bold;
  color: #1a73e8;
  margin-bottom: 16rpx;
}

.elderly-subtitle {
  font-size: 36rpx;
  color: #5f6368;
}

.elderly-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 40rpx;
  width: 100%;
  max-width: 700rpx;
  padding: 20rpx 0;
}

.elderly-btn {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  background: linear-gradient(135deg, #1a73e8 0%, #4285f4 100%);
  border-radius: 32rpx;
  padding: 70rpx 20rpx;
  box-shadow: 0 8rpx 24rpx rgba(26, 115, 232, 0.3);
  transition: transform 0.15s ease, box-shadow 0.15s ease;
  active: scale(0.96);
}

.elderly-btn:active {
  transform: scale(0.96);
  box-shadow: 0 4rpx 12rpx rgba(26, 115, 232, 0.25);
}

.elderly-btn-text {
  font-size: 56rpx;
  font-weight: bold;
  color: #ffffff;
  letter-spacing: 6rpx;
}

/* ========== 老年版底部导航栏 ========== */
.elderly-bottom-nav {
  height: 90rpx !important;
}

.elderly-nav-item {
  padding: 16rpx 0 !important;
}

.elderly-nav-icon {
  width: 44rpx !important;
  height: 44rpx !important;
  margin-bottom: 6rpx !important;
}

.elderly-nav-text {
  font-size: 28rpx !important;
  font-weight: bold;
}

/* 轮播图区域 - 占屏幕顶部三分之一 */
.carousel-section {
  width: 100%;
  height: 33vh;
  margin-bottom: 20px;
}

.carousel {
  width: 100%;
  height: 100%;
}

.carousel-image {
  width: 100%;
  height: 100%;
}

/* 内容区域 - 对应<view class="content">，包含所有功能入口 */
.content {
  display: flex;
  flex-direction: column;
  gap: 15px;
  align-items: center;
  padding: 0 20px;
  flex: 1;
}

/* 按钮网格容器 - 对应<view class="button-grid">，实现2x2布局 */
.button-grid {
  display: flex;
  flex-direction: column;
  gap: 40px;
  width: 100%;
  max-width: 600px;
}

/* 网格行 - 对应<view class="grid-row">，每行包含2个按钮 */
.grid-row {
  display: flex;
  justify-content: space-between;
  gap: 0px;
}

/* 网格项 - 对应<view class="grid-item">，每个按钮容器 */
.grid-item {
  flex: 1;
  display: flex;
  justify-content: center;
}

/* 按钮样式 - 对应<navigator class="btn">，用于功能入口导航 */
.btn {
  padding: 10px 20px;
  background-color: #11ffee00; /* 透明背景色 */
  color: black;
  text-align: center;
  border-radius: 5px;
  display: flex;
  justify-content: center;
  align-items: center;
}

/* 按钮图片样式 - 对应<image class="button-image"> */
.button-image {
  width: 150px;
  height: 150px;
}

/* 底部导航栏 */
.bottom-nav {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  display: flex;
  background-color: #fff;
  border-top: 1px solid #eee;
  height: 60px;
  z-index: 1000;
}

.nav-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 8px 0;
}

.nav-item.active {
  background-color: #f0f8ff;
}

.nav-icon {
  width: 24px;
  height: 24px;
  margin-bottom: 4px;
}

.nav-text {
  font-size: 12px;
  color: #000000;
}

.nav-item.active .nav-text {
  color: #1aad19;
}

/* 备用按钮图片样式（当前未使用） */
.button-image1 {
  width: 80px;
  height: 80px;
}
.button-image2 {
  width: 80px;
  height: 80px;
}
.button-image3 {
  width: 80px;
  height: 80px;
}