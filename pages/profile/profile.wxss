.container {
  background-color: #f8f9fa;
  min-height: 100vh;
  padding-bottom: 40rpx;
}

/* 顶部身份区 */
.identity-section {
  background: linear-gradient(135deg, #e3f2fd 0%, #f3e5f5 100%);
  padding: 40rpx 30rpx 30rpx;
  border-radius: 0 0 30rpx 30rpx;
}

.identity-header {
  display: flex;
  flex-direction: column;
  align-items: center;
}

.avatar-area {
  display: flex;
  align-items: center;
  margin-bottom: 20rpx;
}

.avatar-container {
  position: relative;
  margin-right: 20rpx;
}

.user-avatar {
  width: 120rpx;
  height: 120rpx;
  border-radius: 50%;
  border: 4rpx solid #fff;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.1);
}

.default-avatar {
  width: 120rpx;
  height: 120rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, #4fc3f7 0%, #29b6f6 100%);
  display: flex;
  align-items: center;
  justify-content: center;
  border: 4rpx solid #fff;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.1);
}

.avatar-icon {
  font-size: 48rpx;
  color: #fff;
}

.greeting-area {
  flex: 1;
}

.greeting-text {
  font-size: 36rpx;
  font-weight: 600;
  color: #1976d2;
  display: block;
  margin-bottom: 8rpx;
}

.care-motto {
  font-size: 24rpx;
  color: #666;
  display: block;
}

.health-status {
  text-align: center;
  margin-top: 20rpx;
}

.status-tag {
  margin-bottom: 10rpx;
}

.status-desc {
  font-size: 24rpx;
  color: #666;
  display: block;
}

/* 卡片区域 */
.cards-section {
  padding: 30rpx;
}

.health-card,
.knowledge-card,
.service-card {
  margin-bottom: 30rpx;
  background: #fff;
  border-radius: 20rpx;
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.06);
}

.card-content {
  font-size: 28rpx;
  color: #333;
  margin-left: 15rpx;
}

.record-count {
  font-size: 24rpx;
  color: #999;
}

.card-tip {
  padding: 20rpx 30rpx;
  border-top: 1rpx solid #f0f0f0;
}

.card-title {
  font-size: 28rpx;
  color: #333;
  margin-right: 15rpx;
}

.card-count,
.card-desc {
  font-size: 24rpx;
  color: #999;
}

.recommendation {
  border-top: 1rpx solid #f0f0f0;
}

.recommend-text {
  font-size: 26rpx;
  color: #666;
  margin-left: 15rpx;
}

/* AI问诊记录列表 */
.diagnosis-list {
  margin: 20rpx 30rpx;
  background: #fff;
  border-radius: 12rpx;
  border: 1rpx solid #e0e0e0;
  overflow: visible;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.08);
  position: relative;
  z-index: 1;
}

.diagnosis-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 30rpx 25rpx;
  border-bottom: 1rpx solid #f0f0f0;
  background: #fff;
  min-height: 100rpx;
}

.diagnosis-item:last-child {
  border-bottom: none;
}

.diagnosis-item:active {
  background-color: #f8f9fa;
}

.diagnosis-content {
  flex: 1;
  display: flex;
  flex-direction: column;
  justify-content: center;
}

.diagnosis-symptoms {
  font-size: 30rpx;
  color: #1a1a1a;
  display: block;
  margin-bottom: 8rpx;
  font-weight: 500;
  line-height: 1;
}

.diagnosis-time {
  font-size: 24rpx;
  color: #666;
  display: block;
  font-weight: 400;
}

.toggle-section {
  margin: 0 30rpx;
}

.loading-section {
  margin: 0 30rpx;
}

.loading-text {
  font-size: 26rpx;
  color: #999;
}

.no-records {
  margin: 0 30rpx;
}

.no-records-text {
  font-size: 26rpx;
  color: #999;
}

.no-records-hint {
  font-size: 22rpx;
  color: #ccc;
}

.appointment-info {
  font-size: 26rpx;
  color: #52c41a;
  margin-left: 15rpx;
}

/* 设置区域 */
.settings-section {
  padding: 0 30rpx;
}

.status-text {
  font-size: 24rpx;
  color: #999;
}

/* 底部安全操作区 */
.security-section {
  padding: 30rpx;
  margin-top: 20rpx;
}

.logout-btn {
  margin-bottom: 20rpx;
}

.privacy-notice {
  text-align: center;
}

/* 响应式调整 */
@media (max-width: 375px) {
  .identity-section {
    padding: 30rpx 20rpx 20rpx;
  }
  
  .cards-section {
    padding: 20rpx;
  }
  
  .settings-section {
    padding: 0 20rpx;
  }
}

/* 动画效果 */
.health-card,
.knowledge-card,
.service-card {
  transition: transform 0.3s ease, box-shadow 0.3s ease;
}

.health-card:active,
.knowledge-card:active,
.service-card:active {
  transform: translateY(-2rpx);
  box-shadow: 0 6rpx 25rpx rgba(0, 0, 0, 0.1);
}

/* 无障碍支持 */
.user-avatar {
  cursor: pointer;
}

.user-avatar:focus {
  outline: 2rpx solid #1976d2;
  outline-offset: 2rpx;
}

/* 高对比度模式支持 */
@media (prefers-contrast: high) {
  .identity-section {
    background: #e8f4fd;
    border: 1rpx solid #1976d2;
  }
  
  .health-card,
  .knowledge-card,
  .service-card {
    border: 1rpx solid #ddd;
  }
}

/* 收藏文章列表样式 */
.favorite-list {
  margin: 0 30rpx;
}

.favorite-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 20rpx 0;
  border-bottom: 1rpx solid #f0f0f0;
  cursor: pointer;
}

.favorite-item:last-child {
  border-bottom: none;
}

.favorite-content {
  flex: 1;
  display: flex;
  flex-direction: column;
}

.favorite-title {
  font-size: 28rpx;
  color: #333;
  line-height: 1.4;
  margin-bottom: 8rpx;
}

.favorite-time {
  font-size: 24rpx;
  color: #999;
}

.toggle-section {
  margin-top: 10rpx;
}

.toggle-text {
  font-size: 26rpx;
  color: #1976d2;
  text-align: center;
  display: block;
}