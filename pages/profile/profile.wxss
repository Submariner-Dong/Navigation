/* ========== 页面基础布局 ========== */
.container {
  background-color: #f8f9fa;
  min-height: 100vh;
  padding-bottom: 120rpx; /* 增加底部内边距，为固定导航栏留出空间 */
}

/* ========== 顶部身份区域 ========== */
/* 渐变背景区域，包含用户头像和健康状态 */
.identity-section {
  background: linear-gradient(135deg, #e3f2fd 0%, #f3e5f5 100%);
  padding: 40rpx 30rpx 30rpx;
  border-radius: 0 0 30rpx 30rpx;
}

.identity-header {
  display: flex;
  flex-direction: column;
  align-items: center;
}

/* 头像区域 */
.avatar-area {
  display: flex;
  align-items: center;
  margin-bottom: 20rpx;
}

.avatar-container {
  position: relative;
  margin-right: 20rpx;
}

/* 用户头像样式 */
.user-avatar {
  width: 120rpx;
  height: 120rpx;
  border-radius: 50%;
  border: 4rpx solid #fff;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.1);
}

/* 默认头像（用户未设置时显示） */
.default-avatar {
  width: 120rpx;
  height: 120rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, #4fc3f7 0%, #29b6f6 100%);
  display: flex;
  align-items: center;
  justify-content: center;
  border: 4rpx solid #fff;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.1);
}

.avatar-icon {
  font-size: 48rpx;
  color: #fff;
}

/* 问候语区域 */
.greeting-area {
  flex: 1;
}

.greeting-text {
  font-size: 36rpx;
  font-weight: 600;
  color: #1976d2;
  display: block;
  margin-bottom: 8rpx;
}

.care-motto {
  font-size: 24rpx;
  color: #666;
  display: block;
}

/* 健康状态标识 */
.health-status {
  text-align: center;
  margin-top: 20rpx;
}

.status-tag {
  margin-bottom: 10rpx;
}

.status-desc {
  font-size: 24rpx;
  color: #666;
  display: block;
}

/* ========== 卡片区域 ========== */
/* 主要功能卡片区域，包含AI问诊记录、收藏文章等 */
.cards-section {
  padding: 30rpx;
}

/* 卡片通用样式 */
.health-card,
.service-card {
  margin-bottom: 30rpx;
  background: #fff;
  border-radius: 20rpx;
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.06);
}

/* 卡片标题样式 */
.card-title {
  font-size: 28rpx;
  color: #333;
  margin-right: 15rpx;
}

/* 卡片计数和描述文字 */
.card-count,
.card-desc {
  font-size: 24rpx;
  color: #999;
}

/* 记录数量显示 */
.record-count {
  font-size: 24rpx;
  color: #999;
}

/* 卡片提示信息 */
.card-tip {
  padding: 20rpx 30rpx;
  border-top: 1rpx solid #f0f0f0;
}

/* ========== AI问诊记录列表 ========== */
/* AI诊断历史记录列表样式 */
.diagnosis-list {
  margin: 20rpx 30rpx;
  background: #fff;
  border-radius: 12rpx;
  border: 1rpx solid #e0e0e0;
  overflow: visible;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.08);
  position: relative;
  z-index: 1;
}

/* 诊断记录项 */
.diagnosis-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 30rpx 25rpx;
  border-bottom: 1rpx solid #f0f0f0;
  background: #fff;
  min-height: 50rpx; 
}

.diagnosis-item:last-child {
  border-bottom: none;
}

.diagnosis-item:active {
  background-color: #f8f9fa;
}

.diagnosis-content {
  flex: 1;
  display: flex;
  flex-direction: column;
  justify-content: center;
}

.diagnosis-symptoms {
  font-size: 30rpx;
  color: #1a1a1a;
  display: block;
  margin-bottom: 8rpx;
  font-weight: 500;
  line-height: 1;
}

.diagnosis-time {
  font-size: 24rpx;
  color: #666;
  display: block;
  font-weight: 400;
}

/* ========== 收藏文章列表 ========== */
.favorite-list {
  margin: 0 30rpx;
  margin: 20rpx 30rpx;
  background: #fff;
  border-radius: 12rpx;
  border: 1rpx solid #e0e0e0;
  overflow: visible;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.08);
  position: relative;
  z-index: 1;
}

.favorite-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 30rpx 25rpx;
  border-bottom: 1rpx solid #f0f0f0;
  background: #fff;
  min-height: 50rpx;
}

.favorite-item:last-child {
  border-bottom: none;
}

.favorite-item:active {
  background-color: #f8f9fa;
}

.favorite-content {
  flex: 1;
  display: flex;
  flex-direction: column;
  justify-content: center;
}

.favorite-title {
  font-size: 30rpx;
  color: #1a1a1a;
  display: block;
  margin-bottom: 8rpx;
  font-weight: 500;
  line-height: 1;
}

.favorite-time {
  font-size: 24rpx;
  color: #666;
  display: block;
  font-weight: 400;
}

/* ========== 常用科室列表 ========== */
.common-departments-list {
  margin: 20rpx 30rpx;
  background: #fff;
  border-radius: 12rpx;
  border: 1rpx solid #e0e0e0;
  overflow: visible;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.08);
  position: relative;
  z-index: 1;
}

.department-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 30rpx 25rpx;
  border-bottom: 1rpx solid #f0f0f0;
  background: #fff;
  min-height: 50rpx;
}

.department-item:last-child {
  border-bottom: none;
}

.department-item:active {
  background-color: #f8f9fa;
}

.department-content {
  flex: 1;
  display: flex;
  flex-direction: column;
  justify-content: center;
}

.department-name {
  font-size: 30rpx;
  color: #1a1a1a;
  display: block;
  margin-bottom: 8rpx;
  font-weight: 500;
  line-height: 1;
}

.department-count {
  font-size: 24rpx;
  color: #666;
  display: block;
  font-weight: 400;
}

/* ========== 通用组件样式 ========== */
/* 展开/收起区域 */
.toggle-section {
  margin: 0 30rpx;
}

.toggle-text {
  font-size: 26rpx;
  color: #1976d2;
  text-align: center;
  display: block;
}

/* 加载状态 */
.loading-section {
  margin: 0 30rpx;
}

.loading-text {
  font-size: 26rpx;
  color: #999;
}

/* 无记录提示 */
.no-records {
  margin: 0 30rpx;
}

.no-records-text {
  font-size: 26rpx;
  color: #999;
}

/* 预约信息 */
.appointment-info {
  font-size: 26rpx;
  color: #52c41a;
  margin-left: 15rpx;
}

/* ========== 设置区域 ========== */
.settings-section {
  padding: 0 30rpx;
}

.status-text {
  font-size: 24rpx;
  color: #999;
}

/* ========== 底部安全操作区 ========== */
.security-section {
  padding: 30rpx;
  margin-top: 20rpx;
}

.logout-btn {
  margin-bottom: 20rpx;
}

.privacy-notice {
  text-align: center;
}

/* ========== 响应式设计 ========== */
@media (max-width: 375px) {
  .identity-section {
    padding: 30rpx 20rpx 20rpx;
  }
  
  .cards-section {
    padding: 20rpx;
  }
  
  .settings-section {
    padding: 0 20rpx;
  }
}

/* ========== 交互效果 ========== */
/* 卡片点击效果 */
.health-card,
.service-card {
  transition: transform 0.3s ease, box-shadow 0.3s ease;
}

.health-card:active,
.service-card:active {
  transform: translateY(-2rpx);
  box-shadow: 0 6rpx 25rpx rgba(0, 0, 0, 0.1);
}

/* 无障碍支持 */
.user-avatar {
  cursor: pointer;
}

.user-avatar:focus {
  outline: 2rpx solid #1976d2;
  outline-offset: 2rpx;
}

/* ========== 高对比度模式支持 ========== */
@media (prefers-contrast: high) {
  .identity-section {
    background: #e8f4fd;
    border: 1rpx solid #1976d2;
  }
  
  .health-card,
  .service-card {
    border: 1rpx solid #ddd;
  }
}

/* ========== 底部导航栏固定样式 ========== */
.bottom-nav {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  display: flex;
  background-color: #fff;
  border-top: 1px solid #eee;
  height: 60px;
  z-index: 1000;
}

.nav-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 8px 0;
}

.nav-item.active {
  background-color: #f0f8ff;
}

.nav-icon {
  width: 24px;
  height: 24px;
  margin-bottom: 4px;
}

.nav-text {
  font-size: 12rpx;
  color: #000000;
}

.nav-item.active .nav-text {
  color: #1aad19;
}

/* ========== 病历信息卡片样式 ========== */
.medical-record-card {
  margin-bottom: 30rpx;
  background: #fff;
  border-radius: 20rpx;
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.06);
}

.medical-record-card:active {
  transform: translateY(-2rpx);
  box-shadow: 0 6rpx 25rpx rgba(0, 0, 0, 0.1);
}

/* 病历信息列表 */
.medical-records-list {
  margin: 20rpx 30rpx;
  background: #fff;
  border-radius: 12rpx;
  border: 1rpx solid #e0e0e0;
  overflow: visible;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.08);
  position: relative;
  z-index: 1;
}

.medical-record-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 30rpx 25rpx;
  border-bottom: 1rpx solid #f0f0f0;
  background: #fff;
  min-height: 80rpx;
}

.medical-record-item:last-child {
  border-bottom: none;
}

.medical-record-item:active {
  background-color: #f8f9fa;
}

.medical-record-content {
  flex: 1;
  display: flex;
  flex-direction: column;
  justify-content: center;
}

.record-department {
  font-size: 28rpx;
  color: #1a1a1a;
  display: block;
  margin-bottom: 5rpx;
  font-weight: 500;
  line-height: 1.2;
}

.record-diagnosis {
  font-size: 24rpx;
  color: #52c41a;
  display: block;
  margin-bottom: 5rpx;
  font-weight: 400;
}

.record-time {
  font-size: 22rpx;
  color: #666;
  display: block;
  font-weight: 400;
}

/* ========== 手动添加病历按钮 ========== */
.add-record-section {
  padding: 20rpx 30rpx;
  border-top: 1rpx solid #f0f0f0;
}

.add-record-btn {
  width: 100%;
  border-radius: 12rpx;
}

/* ========== 游客模式样式 ========== */
.guest-logo {
  width: 120rpx;
  height: 120rpx;
}
.guest-status {
  text-align: center;
  margin-top: 20rpx;
}

.guest-prompt-card {
  background: #fff;
  border-radius: 20rpx;
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.06);
  padding: 50rpx 40rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.guest-prompt-icon {
  font-size: 80rpx;
  margin-bottom: 24rpx;
}

.guest-prompt-title {
  font-size: 34rpx;
  font-weight: 600;
  color: #333;
  margin-bottom: 36rpx;
}

.guest-feature-list {
  width: 100%;
  margin-bottom: 40rpx;
}

.guest-feature-item {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 16rpx 0;
  font-size: 28rpx;
  color: #555;
  border-bottom: 1rpx solid #f5f5f5;
}

.guest-feature-item:last-child {
  border-bottom: none;
}

.login-btn-guest {
  width: 100% !important;
  height: 92rpx !important;
  border-radius: 46rpx !important;
  font-size: 32rpx !important;
}