<view class="container">
  <!-- 顶部身份区 - 强调专业与关怀 -->
  <view class="identity-section">
    <view class="identity-header">
      <view class="avatar-area">
        <view class="avatar-container">
          <image 
            wx:if="{{userAccount}}" 
            src="{{userAccount.avatarUrl}}" 
            class="user-avatar"
            mode="aspectFill"
            bindtap="changeAvatar"
          />
          <view wx:else class="default-avatar">
            <text class="avatar-icon">🦷</text>
          </view>
        </view>
        
        <view class="greeting-area">
          <text class="greeting-text">
            {{userAccount ? '欢迎回来，' + userAccount.nickName + '！' : '您好，欢迎使用青芽智医'}}
          </text>
          <text class="care-motto">关爱口腔，从记录开始</text>
        </view>
      </view>
      
      <!-- 口腔健康状态标识 -->
      <view class="health-status">
        <t-tag theme="{{healthStatus.theme}}" variant="light" class="status-tag">
          {{healthStatus.text}}
        </t-tag>
        <text class="status-desc">{{healthStatus.desc}}</text>
      </view>
    </view>
  </view>

  <!-- 核心功能卡片区域 -->
  <view class="cards-section">
    <!-- 第一卡片：我的健康档案 -->
    <view class="health-card">
      <!-- 健康日志卡片 -->
      <t-cell-group title="我的口腔健康日志">
        <t-cell arrow bindtap="viewAiDiagnosisHistory">
          <view slot="title">
            <t-tag theme="primary" variant="light" size="small">智能问诊记录</t-tag>
          </view>
          <view slot="note">
            <text class="record-count">{{aiRecordsCount}} 次记录</text>
          </view>
        </t-cell>
        
        <!-- 加载状态 -->
        <view wx:if="{{loading}}" class="loading-section">
          <t-cell>
            <view slot="title">
              <text class="loading-text">正在加载智能问诊记录...</text>
            </view>
            <view slot="note">
              <t-icon name="loading" size="16" color="#999"></t-icon>
            </view>
          </t-cell>
        </view>
        
        <!-- 无记录时的提示 -->
        <view wx:if="{{!loading && aiDiagnosisList.length === 0}}" class="no-records">
          <t-cell>
            <view slot="title">
              <text class="no-records-text">您还没有智能问诊记录，请先使用智能问诊功能</text>
            </view>
          </t-cell>
        </view>
        
        <!-- AI问诊记录列表 - 默认显示前3条 -->
        <view wx:if="{{!loading && displayedDiagnosisList.length > 0}}" class="diagnosis-list">
          <view wx:for="{{displayedDiagnosisList}}" wx:key="id" class="diagnosis-item" bindtap="viewAiDiagnosisDetail" data-index="{{index}}">
            <view class="diagnosis-content">
              <text class="diagnosis-symptoms">{{index + 1}}. {{item.symptoms}}</text>
              <text class="diagnosis-time">{{item.formattedTime}}</text>
            </view>
            <t-icon name="chevron-right" size="16" color="#999"></t-icon>
          </view>
        </view>
        
        <!-- 查看更多记录 -->
        <view wx:if="{{!loading && remainingDiagnosisList.length > 0}}" class="toggle-section">
          <t-cell bindtap="toggleDiagnosisList">
            <view slot="title">
              <text class="toggle-text">{{showAllDiagnosis ? '收起更多记录' : '查看更多记录(' + remainingDiagnosisList.length + '条)'}}</text>
            </view>
          </t-cell>
        </view>
        
        <view class="card-tip">
          <t-message theme="info" size="small">定期记录，更了解自己的口腔</t-message>
        </view>
      </t-cell-group>
    </view>

    <!-- 第二卡片：我的知识库 -->
    <view class="service-card">
      <t-cell-group title="我的收藏">
        <t-cell>
          <view slot="title">
            <t-tag theme="primary" variant="light" size="small">收藏的文章</t-tag>
          </view>
          <view slot="note">
            <text class="record-count">{{favoriteArticles}} 篇收藏</text>
          </view>
        </t-cell>
        
        <!-- 无收藏文章时的提示 -->
        <view wx:if="{{!loading && favoriteArticles === 0}}" class="no-records">
          <t-cell>
            <view slot="title">
              <text class="no-records-text">您还没有收藏的文章，请先使用科普知识收藏文章</text>
            </view>
          </t-cell>
        </view>
        
        <!-- 收藏文章列表 - 默认显示前3条 -->
        <view wx:if="{{displayedFavoriteArticles.length > 0}}" class="favorite-list">
          <view wx:for="{{displayedFavoriteArticles}}" wx:key="id" class="favorite-item" bindtap="viewFavoriteArticle" data-id="{{item.id}}">
            <view class="favorite-content">
              <text class="favorite-title">{{index + 1}}. {{item.title}}</text>
              <text class="favorite-time">{{item.formattedTime}}</text>
            </view>
            <t-icon name="chevron-right" size="16" color="#999"></t-icon>
          </view>
        </view>
        
        <!-- 查看更多收藏 -->
        <view wx:if="{{remainingFavoriteArticles.length > 0}}" class="toggle-section">
          <t-cell bindtap="toggleFavoriteList">
            <view slot="title">
              <text class="toggle-text">{{showAllFavorites ? '收起更多收藏' : '查看更多收藏(' + remainingFavoriteArticles.length + '篇)'}}</text>
            </view>
          </t-cell>
        </view>
      </t-cell-group>
    </view>

    <!-- 第三卡片：我的就诊服务 -->
    <view class="service-card">
      <t-cell-group title="我的就诊相关">
        <t-cell>
          <view slot="title">
            <t-tag theme="primary" variant="light" size="small">常用科室</t-tag>
          </view>
          <view slot="note">
            <text class="record-count">{{commonDepartmentsCount}} 个常用</text>
          </view>
        </t-cell>
        
        <!-- 无常用科室时的提示 -->
        <view wx:if="{{!loading && commonDepartmentsCount === 0}}" class="no-records">
          <t-cell>
            <view slot="title">
              <text class="no-records-text">您还没有常用的科室记录，请先使用智能问诊或院内导航功能</text>
            </view>
          </t-cell>
        </view>
        
        <!-- 常用科室列表 - 显示前3个 -->
        <view wx:if="{{commonDepartmentsList.length > 0}}" class="common-departments-list">
          <view wx:for="{{commonDepartmentsList}}" wx:key="id" class="department-item" bindtap="navigateToDepartment" data-name="{{item.name}}">
            <view class="department-content">
              <text class="department-name">{{index + 1}}. {{item.name}}</text>
              <text class="department-count">使用 {{item.count}} 次</text>
            </view>
          </view>
        </view>
      </t-cell-group>
    </view>
  </view>

  <!-- 设置与信息管理列表 -->
  <view class="settings-section">
    <!-- 账户与安全 -->
    <t-cell-group title="账户与安全">
      <t-cell arrow bindtap="bindPhone">
        <view slot="title">
          <text>绑定手机</text>
        </view>
        <view slot="note">
          <text class="status-text">{{userInfo.phone ? '已绑定' : '未绑定'}}</text>
        </view>
      </t-cell>
    </t-cell-group>

    <!-- 偏好设置 -->
    <t-cell-group title="偏好设置">
      <t-cell arrow bindtap="dataManagement">
        <view slot="title">
          <text>数据管理</text>
        </view>
      </t-cell>
    </t-cell-group>

    <!-- 关于与帮助 -->
    <t-cell-group title="关于与帮助">
      <t-cell arrow bindtap="aboutApp">
        <view slot="title">
          <text>关于青芽智医</text>
        </view>
      </t-cell>
      
      <t-cell arrow bindtap="viewPrivacyPolicy">
        <view slot="title">
          <text>隐私政策</text>
        </view>
      </t-cell>
      
      <t-cell arrow bindtap="contactSupport">
        <view slot="title">
          <text>联系客服</text>
        </view>
      </t-cell>
    </t-cell-group>
  </view>

  <!-- 底部安全操作区 -->
  <view class="security-section">
    <t-button theme="default" size="large" bindtap="logout" class="logout-btn">
      退出登录
    </t-button>
    
    <view class="privacy-notice">
      <t-message theme="info" size="small">
        您的健康数据将严格保密，仅用于为您提供更好的服务
      </t-message>
    </view>
  </view>
</view>

<!-- 底部导航栏 -->
<view class="bottom-nav">
  <view class="nav-item {{currentPage === 'index' ? 'active' : ''}}" bindtap="switchToIndex">
    <image src="{{images.HOME_ICON}}" mode="aspectFit" class="nav-icon"></image>
    <text class="nav-text">首页</text>
  </view>
  <view class="nav-item {{currentPage === 'profile' ? 'active' : ''}}" bindtap="switchToProfile">
    <image src="{{images.PROFILE_ICON}}" mode="aspectFit" class="nav-icon"></image>
    <text class="nav-text">我的</text>
  </view>
</view>