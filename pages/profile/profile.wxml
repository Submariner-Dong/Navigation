<view class="container">
  <!-- 顶部身份区 - 强调专业与关怀 -->
  <view class="identity-section">
    <view class="identity-header">
      <view class="avatar-area">
        <view class="avatar-container">
          <image 
            wx:if="{{userAccount}}" 
            src="{{userAccount.avatarUrl}}" 
            class="user-avatar"
            mode="aspectFill"
            bindtap="changeAvatar"
          />
          <view wx:else class="default-avatar">
            <text class="avatar-icon">🦷</text>
          </view>
        </view>
        <view class="greeting-area">
          <text class="greeting-text">
            {{userAccount ? '欢迎回来，' + userAccount.nickName + '！' : '您好，欢迎使用青芽智医'}}
          </text>
          <text class="care-motto">关爱口腔，从记录开始</text>
        </view>
      </view>
      
      <!-- 口腔健康状态标识 -->
      <view class="health-status">
        <t-tag theme="{{healthStatus.theme}}" variant="light" class="status-tag">
          {{healthStatus.text}}
        </t-tag>
        <text class="status-desc">{{healthStatus.desc}}</text>
      </view>
    </view>
  </view>

  <!-- 核心功能卡片区域 -->
  <view class="cards-section">
    <!-- 第一卡片：我的健康档案 -->
    <view class="health-card">
      <t-cell-group title="我的口腔健康日志">
        <t-cell arrow bindtap="viewAiDiagnosisHistory">
          <view slot="title">
            <t-tag theme="primary" variant="light" size="small">AI问诊记录</t-tag>
            <text class="card-content">{{latestDiagnosis || '暂无记录'}}</text>
          </view>
          <view slot="note">
            <text class="record-count">{{aiRecordsCount}} 次记录</text>
          </view>
        </t-cell>
        
        <!-- AI问诊记录列表 -->
        <view wx:if="{{aiDiagnosisList.length > 0 && showAllDiagnosis}}" class="diagnosis-list">
          <view wx:for="{{aiDiagnosisList}}" wx:key="id" class="diagnosis-item" bindtap="viewAiDiagnosisDetail" data-index="{{index}}">
            <view class="diagnosis-content">
              <text class="diagnosis-symptoms">{{item.symptoms}}</text>
              <view class="diagnosis-meta">
                <t-tag theme="{{item.severity === 'severe' ? 'danger' : item.severity === 'moderate' ? 'warning' : 'primary'}}" 
                       variant="light" size="mini">
                  {{item.department}}
                </t-tag>
                <text class="diagnosis-time">{{item.timestamp ? item.timestamp.split('T')[0] : '未知时间'}}</text>
              </view>
            </view>
            <t-icon name="chevron-right" size="16" color="#999"></t-icon>
          </view>
        </view>
        
        <!-- 折叠/展开按钮 -->
        <view wx:if="{{aiDiagnosisList.length > 1}}" class="toggle-section">
          <t-cell bindtap="toggleDiagnosisList">
            <view slot="title">
              <text class="toggle-text">{{showAllDiagnosis ? '收起记录' : '查看更多(' + (aiDiagnosisList.length - 3) + '条)'}}</text>
            </view>
            <view slot="note">
              <t-icon name="{{showAllDiagnosis ? 'chevron-up' : 'chevron-down'}}" size="16" color="#999"></t-icon>
            </view>
          </t-cell>
        </view>
        
        <t-cell arrow bindtap="viewSelfCheckRecords">
          <view slot="title">
            <t-tag theme="success" variant="light" size="small">自查记录</t-tag>
            <text class="card-content">{{selfCheckCount}} 次自查</text>
          </view>
        </t-cell>
        
        <view class="card-tip">
          <t-message theme="info" size="small">定期记录，更了解自己的口腔</t-message>
        </view>
      </t-cell-group>
    </view>

    <!-- 第二卡片：我的知识库 -->
    <view class="knowledge-card">
      <t-cell-group title="我的科普收藏">
        <t-cell arrow bindtap="viewFavorites">
          <view slot="title">
            <text class="card-title">收藏的文章</text>
            <text class="card-count">{{favoriteArticles}} 篇</text>
          </view>
        </t-cell>
        
        <t-cell arrow bindtap="viewWatchedVideos">
          <view slot="title">
            <text class="card-title">看过的视频</text>
            <text class="card-count">{{watchedVideos}} 个</text>
          </view>
        </t-cell>
        
        <view wx:if="{{recommendedArticle}}" class="recommendation">
          <t-cell arrow bindtap="viewRecommendedArticle">
            <view slot="title">
              <t-tag theme="warning" variant="light" size="small">推荐阅读</t-tag>
              <text class="recommend-text">{{recommendedArticle}}</text>
            </view>
          </t-cell>
        </view>
      </t-cell-group>
    </view>

    <!-- 第三卡片：我的就诊服务 -->
    <view class="service-card">
      <t-cell-group title="我的就诊相关">
        <t-cell arrow bindtap="viewCommonDepartments">
          <view slot="title">
            <text class="card-title">常用科室</text>
            <text class="card-desc">{{commonDepartmentsCount}} 个常用</text>
          </view>
        </t-cell>
        
        <t-cell arrow bindtap="viewFavoriteHospitals">
          <view slot="title">
            <text class="card-title">关注的医院</text>
            <text class="card-desc">{{favoriteHospitals}} 家关注</text>
          </view>
        </t-cell>
        
        <t-cell wx:if="{{latestAppointment}}" arrow bindtap="viewAppointments">
          <view slot="title">
            <t-tag theme="success" variant="light" size="small">最近预约</t-tag>
            <text class="appointment-info">{{latestAppointment}}</text>
          </view>
        </t-cell>
      </t-cell-group>
    </view>
  </view>

  <!-- 设置与信息管理列表 -->
  <view class="settings-section">
    <!-- 账户与安全 -->
    <t-cell-group title="账户与安全">
      <t-cell arrow bindtap="bindPhone">
        <view slot="title">
          <text>绑定手机</text>
        </view>
        <view slot="note">
          <text class="status-text">{{userInfo.phone ? '已绑定' : '未绑定'}}</text>
        </view>
      </t-cell>
      
      <t-cell arrow bindtap="privacySettings">
        <view slot="title">
          <text>隐私设置</text>
        </view>
      </t-cell>
    </t-cell-group>

    <!-- 偏好设置 -->
    <t-cell-group title="偏好设置">
      <t-cell arrow bindtap="notificationSettings">
        <view slot="title">
          <text>消息通知</text>
        </view>
        <view slot="note">
          <t-switch checked="{{notificationEnabled}}" bindchange="toggleNotification" />
        </view>
      </t-cell>
      
      <t-cell arrow bindtap="dataManagement">
        <view slot="title">
          <text>数据管理</text>
        </view>
      </t-cell>
      
      <t-cell arrow bindtap="clearCache">
        <view slot="title">
          <text>清除缓存</text>
        </view>
      </t-cell>
    </t-cell-group>

    <!-- 关于与帮助 -->
    <t-cell-group title="关于与帮助">
      <t-cell arrow bindtap="aboutApp">
        <view slot="title">
          <text>关于青芽智医</text>
        </view>
      </t-cell>
      
      <t-cell arrow bindtap="viewPrivacyPolicy">
        <view slot="title">
          <text>隐私政策</text>
        </view>
      </t-cell>
      
      <t-cell arrow bindtap="contactSupport">
        <view slot="title">
          <text>联系客服</text>
        </view>
      </t-cell>
    </t-cell-group>
  </view>

  <!-- 底部安全操作区 -->
  <view class="security-section">
    <t-button theme="default" size="large" bindtap="logout" class="logout-btn">
      退出登录
    </t-button>
    
    <view class="privacy-notice">
      <t-message theme="info" size="small">
        您的健康数据将严格保密，仅用于为您提供更好的服务
      </t-message>
    </view>
  </view>
</view>