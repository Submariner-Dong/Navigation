/* ========== 院内导航页面样式 - navigation.wxml对应 ========== */

/* 主容器 - 对应navigation.wxml中的<view class="container"> */
.container {
  display: flex;
  flex-direction: column;
  justify-content: center;
  align-items: center;
}

/* 输入容器 - 对应<view class="input-container" wx:if="{{!showNavigation}}"> */
.input-container {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 20px;
  width: 80%;
}

/* 选择器容器 - 当前未使用，备用样式 */
.picker-container {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 20px;
  width: 80%;
}

/* 输入容器中的文本样式 - 对应<text>欢迎来到同济大学附属口腔医院</text> */
.input-container text {
  font-size: 16px;
  color: #333;
}

/* 输入框样式 - 当前未使用，备用样式 */
.input-container input {
  width: 100%;
  padding: 10px;
  border: 1px solid #ccc;
  border-radius: 4px;
}

/* 搜索按钮样式 - 对应<button class="search-button" bindtap="handleSearch">前往</button> */
.search-button {
  width: 100%;
  padding: 10px;
  background-color: #07c160;
  color: white;
  border: none;
  border-radius: 4px;
}

/* 图片容器 - 当前未使用，用于导航地图显示 */
.image-container {
  flex: 1;
  display: flex;
  justify-content: center;
  align-items: center;
  background-color: #f5f5f5;
}

/* 导航图片样式 - 当前未使用 */
.navigation-image {
  display: flex;
}

/* 文本容器 - 当前未使用 */
.text-container {
  flex: 1;
  padding: 20px;
  display: flex;
  justify-content: center;
  align-items: center;
  background-color: #ffffff;
}

/* 选项容器 - 当前未使用 */
.options-container {
  display: flex;
  flex-direction: column;
  gap: 20px;
  width: 80%;
  margin: 20px 0;
}

/* 选项按钮样式 - 当前未使用 */
.options-container button {
  width: 100%;
  padding: 15px;
  background-color: #07c160;
  color: white;
  border: none;
  border-radius: 4px;
}

/* 下一步按钮 - 当前未使用 */
.next-button {
  position: fixed;
  right: 20px;
  bottom: 20px;
  background-color: #07c160;
  color: white;
}